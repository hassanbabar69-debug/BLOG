<!DOCTYPE html>
<html lang="en">
<head>
     <%- include('./partials/head') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog</title>
</head>
<body>

    <%- include('./partials/nav') %>

    <div class="container mt-4">
        <h1><%= blog.title %></h1>
       <img src="/<%= blog.coverimage %>" alt="" width="700px">
        <pre><%= blog.body %></pre>
    </div>
    <div class="container mt-4">
        <%= blog.createdby.name %>
        <img src="<%- blog.createdby.profileimage %>" width="100px">
    </div>

    <div class="container mt-3">
         <h1>Comments</h1>(<%= comments.length %>)
    <% if (locals.user) { %>
         <form method="post" action="/comment/<%= blog._id %>">

   
  <div class="mb-3 mt-3">
   

    
   
    <input name = "text"  type="text" class="form-control" id="text" aria-describedby="emailHelp" placeholder="Add comment">
    <button type="submit" class="btn btn-sm btn-primary mt-3">Add</button>
   
  </div>
  </form>

 
     
    <% } %>
     <diV class="mt-3">
    <% comments.forEach(comment => { %>
        <div>
            <img src="<%= comment.createdby.profileimage %>" width="50px">
            <%= comment.createdby.name %>:<pre><%= comment.content %></pre>

        </div>
     
    <% }) %>
  </diV>
    </div>
     <%- include('./partials/script') %>
    
</body>
</html>